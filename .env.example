# ============================================
# LRC Forge - Environment Variables
# Copy to .env.local and fill in your values
# ============================================

# ---- OpenAI ----
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ---- Deepgram (dual transcription for better timestamp accuracy) ----
# Get from https://console.deepgram.com — free tier covers plenty of usage
DEEPGRAM_API_KEY=

# ---- Supabase ----
# Get from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ---- Stripe ----
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create in Stripe dashboard first
# Monthly: $5/mo recurring
STRIPE_PRICE_MONTHLY=price_...
# Pack: $10 one-time
STRIPE_PRICE_PACK=price_...

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
